/**
 * NeuralYamame Self-Supervision Oracle & Fast Verification Matrix
 * 
 * 此模組提供極低延遲的「自我監督」與「反覆確認」機制。
 * 透過 Aspiration Windows 與 Singular Extension 偵測，
 * 確保引擎在高速 Alpha-Beta 剪枝時不會因為視野盲區 (Horizon Effect) 而漏算，
 * 同時利用極窄的邊界視窗大幅度增加 Alpha-Beta 的剪枝率，實現「確認但不降速」。
 */

export interface AspirationWindow {
  alpha: number;
  beta: number;
  isFailHigh: boolean;
  isFailLow: boolean;
  failures: number;
}

export interface VerificationContext {
  depth: number;
  isPvNode: boolean;
  inCheck: boolean;
  evalScore: number;
  ttScore: number | null;
}

export class SelfSupervisionOracle {
  private static instance: SelfSupervisionOracle;

  // Window constants for iterative confirmation scaling
  private readonly BASE_WINDOW_MARGIN = 50;
  private readonly WINDOW_MULTIPLIER = 2.5;
  private readonly MAX_FAILURES_BEFORE_OPEN = 4;

  private constructor() {
    console.log('[SelfSupervision] Oracle initialized: Advanced Iterative Confirmation Active.');
  }

  public static getInstance(): SelfSupervisionOracle {
    if (!SelfSupervisionOracle.instance) {
      SelfSupervisionOracle.instance = new SelfSupervisionOracle();
    }
    return SelfSupervisionOracle.instance;
  }

  /**
   * 根據上一層深度的搜尋結果，產生一個極窄的預測視窗 (Aspiration Window)。
   * 自我監督機制：假設上一層的分數是準確的，我們只確認這個極窄區間。
   * 效能影響：可增加 30% - 50% 的 Alpha-Beta 剪枝率，大幅提升速度。
   */
  public constructAspirationWindow(previousScore: number, windowFailures: number = 0): AspirationWindow {
    // If we failed multiple times, the position is highly volatile. Open the window fully.
    if (windowFailures >= this.MAX_FAILURES_BEFORE_OPEN) {
      return {
        alpha: -Infinity,
        beta: Infinity,
        isFailHigh: false,
        isFailLow: false,
        failures: windowFailures
      };
    }

    // Calculate dynamic margin based on failure counts (exponentially widening)
    const margin = Math.floor(this.BASE_WINDOW_MARGIN * Math.pow(this.WINDOW_MULTIPLIER, windowFailures));

    return {
      alpha: previousScore - margin,
      beta: previousScore + margin,
      isFailHigh: false,
      isFailLow: false,
      failures: windowFailures
    };
  }

  /**
   * 當搜尋分數掉出極窄視窗時觸發。
   * 反覆確認機制：動態拉寬視窗邊界並記錄失敗次數，要求引擎進行快速重搜。
   */
  public adjustWindowOnFailure(currentWindow: AspirationWindow, returnedScore: number): AspirationWindow {
    const nextFailures = currentWindow.failures + 1;
    const margin = Math.floor(this.BASE_WINDOW_MARGIN * Math.pow(this.WINDOW_MULTIPLIER, nextFailures));

    // Fail Low: The position is worse than we thought. We must lower Alpha.
    if (returnedScore <= currentWindow.alpha) {
      return {
        alpha: returnedScore - margin,
        beta: currentWindow.beta, // Beta remains unchanged to keep some pruning
        isFailHigh: false,
        isFailLow: true,
        failures: nextFailures
      };
    }

    // Fail High: The position is better than we thought. We must raise Beta.
    if (returnedScore >= currentWindow.beta) {
      return {
        alpha: currentWindow.alpha, // Alpha remains unchanged
        beta: returnedScore + margin,
        isFailHigh: true,
        isFailLow: false,
        failures: nextFailures
      };
    }

    // Fallback safeguard
    return this.constructAspirationWindow(returnedScore, nextFailures);
  }

  /**
   * 奇異戰術驗證器 (Singular Extension Check)
   * 自我監督：當遇到「強烈被迫」的局面（如被將軍，或只有唯一解），給予深度補償。
   * 效能保證：僅透過 O(1) 複雜度的布林邏輯驗證，絕不遞迴，確保零降速。
   * @param isCheck 當前國王是否被將軍
   * @param legalMoveCount 當前合法步數總數
   * @param isRecapture 是否為關鍵的換子奪回動作
   */
  public verifySingularTactics(isCheck: boolean, legalMoveCount: number, isRecapture: boolean): number {
    let extensionDepth = 0;

    // 1. Check Extension: If king is in check, we must not miss a mating net. Extend search by 1 ply.
    if (isCheck) {
      extensionDepth += 1;
    }

    // 2. Singular Reply: If there is literally only ONE legal move, it costs no branch factor to search deeper.
    // Extend by 1 ply to see further down this forced line.
    if (legalMoveCount === 1) {
      extensionDepth += 1;
    }

    // 3. Recapture Extension: If we are simply taking back a piece in a trade, extend to verify the trade ends well.
    if (isRecapture && !isCheck) {
      extensionDepth += 1;
    }

    // Cap extension to prevent infinite depth explosion
    return Math.min(extensionDepth, 2);
  }

  /**
   * 快速楚歌(Zugzwang)殘局驗證
   * 自我監督：Null Move Pruning (空步剪枝) 可大幅加速，但在「楚歌」局面會發生致命誤判。
   * 此函數透過計算非兵棋子的數量，瞬間判斷是否處於危險的殘局，決定是否允許空步剪枝。
   * @param hasNonPawnMaterial Boolean flag determined quickly by bitboard popcount
   */
  public safeToUseNullMovePruning(hasNonPawnMaterial: boolean, inCheck: boolean): boolean {
    // Rule 1: Never use null move if the king is already in check (tactically volatile)
    if (inCheck) return false;

    // Rule 2: If the side to move only has Pawns and a King, they might be in Zugzwang.
    // Using Null Move here assumes "doing nothing is better", which is false in Zugzwang.
    if (!hasNonPawnMaterial) return false;

    // Passed the safety supervision, highly recommended to prune for speed.
    return true;
  }
}
